// Prisma schema for search-slots
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SearchingStatus {
  INPROGRESS
  FOUND
  CANCELED
}

enum SearchingType {
  USUAL
  VIP
  STUDENT
}

// One entity per day being searched.
model Searching {
  id        String          @id @default(uuid()) @db.Uuid
  status    SearchingStatus @default(INPROGRESS)
  type      SearchingType   @default(USUAL)
  date      DateTime        @db.Date
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@index([date])
  @@map("searchings")
}

enum TicketSearchingStatus {
  INPROGRESS
  FOUND
  NOT_FOUND
  CANCELED
}

// Which cabin a ticket searching is looking for.
enum TicketClass {
  ECONOMY
  BUSINESS
  BOTH
}

// One entity per flight day being searched (ASB -> IST).
model TicketSearching {
  id            String                @id @default(uuid()) @db.Uuid
  status        TicketSearchingStatus @default(INPROGRESS)
  ticketClass   TicketClass           @default(BOTH)
  date          DateTime              @db.Date
  // Matching flights captured when the searching was resolved (FoundFlight[]).
  foundFlights  Json?
  foundAt       DateTime?
  lastCheckedAt DateTime?
  checksCount   Int                   @default(0)
  lastError     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Cron queries: INPROGRESS with date >= today (enqueue) / date < today (expire).
  @@index([status, date])
  @@index([date])
  @@map("ticket_searchings")
}
