// Prisma schema for search-slots
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SearchingStatus {
  INPROGRESS
  FOUND
  CANCELED
}

enum SearchingType {
  USUAL
  VIP
  STUDENT
}

// One entity per day being searched.
model Searching {
  id        String          @id @default(uuid()) @db.Uuid
  status    SearchingStatus @default(INPROGRESS)
  type      SearchingType   @default(USUAL)
  date      DateTime        @db.Date
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
  @@index([date])
  @@map("searchings")
}
