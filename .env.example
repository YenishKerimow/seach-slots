# Postgres (used by docker-compose)
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=search_slots
POSTGRES_PORT=5440

# Backend
DATABASE_URL="postgresql://root:root@localhost:5440/search_slots?schema=public"
PORT=3000

# Redis (BullMQ queue for ticket searches)
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_PASSWORD=

# Telegram notifications (slot found)
BOT_TOKEN=
TELEGRAM_CHAT_ID=
